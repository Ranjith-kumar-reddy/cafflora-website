# Copy this file to .env and fill in the values.

# Port for the API server
PORT=4000

# MongoDB connection (the local MongoDB service by default)
MONGODB_URI=mongodb://127.0.0.1:27017/cafflora

# Google sign-in. Create an OAuth client ID of type "Web application" in
# Google Cloud Console, and add http://localhost:5173 to its
# "Authorized JavaScript origins". Paste the client ID here.
GOOGLE_CLIENT_ID=

# Long random string used to sign session cookies (at least 32 characters)
SESSION_SECRET=

# Google accounts that can open the staff orders page, separated by commas
STAFF_EMAILS=staff@example.com

# Number of tables in the café
TABLE_COUNT=12

# Lets you preview the site without Google sign-in. Never works in production.
ALLOW_DEV_LOGIN=false
